[Unit]
Description=Brother John Telegram Bible Study Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/brother-john
ExecStart=/opt/brother-john/venv/bin/python3 /opt/brother-john/bot.py run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

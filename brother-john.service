[Unit]
Description=Brother John Telegram Bible Study Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/brother-john
ExecStart=/usr/bin/python3 /opt/brother-john/bot.py run
Restart=on-failure
RestartSec=10

# Logging is handled by the app (rotating file in /var/log/brother-john)
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
